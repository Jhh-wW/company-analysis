# 기업분석 서비스 환경변수 견본
# 이 파일에는 실제 비밀값을 넣지 않습니다. 웹 앱은 app/.env를 자동으로 읽지 않습니다.
# 필요한 값은 로컬 셸이나 Render의 Environment에 등록하세요. 로컬 실제 조사 엔진은
# 별도로 analysis_engine/.env를 읽을 수 있지만, 그 파일은 Git에 올리지 않습니다.

# ── 실행 모드 ─────────────────────────────────────────────
# [필수] demo는 저장된 자료만 재생해 AI API 비용이 발생하지 않습니다.
PIPELINE=demo

# [필수] 1은 관리자만 접근할 수 있는 첫 배포 잠금입니다.
BETA_ADMIN_ONLY=1

# [선택] 초대 링크의 유효기간(일). 비우면 기본값 60일을 사용합니다.
SHARE_LINK_MAX_AGE_DAYS=60

# [공유 링크 배포 필수] QR·외부 복사용 주소의 검증된 공개 HTTPS origin입니다.
# 요청 Host 헤더는 사용하지 않습니다. 예: https://company-analysis.example.com
SHARE_PUBLIC_BASE_URL=

# [선택] 서버 포트. Render가 자동으로 넣으며, 없으면 Docker는 10000을 사용합니다.
PORT=

# ── Google 로그인과 관리자 ────────────────────────────────
# [관리자 베타 필수] 관리자로 허용할 이메일. 여러 개면 쉼표로 구분합니다.
ADMIN_EMAILS=admin@example.com

# [관리자 베타 필수] Google Cloud에서 발급한 OAuth 클라이언트 ID입니다.
GOOGLE_CLIENT_ID=

# [관리자 베타 필수·비밀] Google OAuth 클라이언트 보안 비밀입니다.
GOOGLE_CLIENT_SECRET=

# [관리자 베타 필수] Google에 등록한 콜백 주소. 배포 시 실제 HTTPS 주소로 바꿉니다.
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# [PDF 출고 필수·별도 원장 사전등록 시 대체 가능] 이메일이 아니라 OAuth 공급자의
# 불변 subject로 신규 PDF의 역할 원장을 최초 생성할 때 쓰는 JSON.
# author·producer는 fact·editorial·visual 검수자가 될 수 없고 세 검수자도 달라야 합니다.
# 실제 Google sub를 넣되 이 견본 파일이나 Git에는 실제 값을 저장하지 마세요.
PDF_RELEASE_PARTICIPANTS={"author":"google:AUTHOR_SUB","producer":"google:PRODUCER_SUB","fact":"google:FACT_SUB","editorial":"google:EDITORIAL_SUB","visual":"google:VISUAL_SUB"}

# [실제 배포 필수·비밀] 수집 원문 Source의 URL·문서 ID·원문 해시·도메인 증명을
# 서버 HMAC으로 잠그는 32바이트 이상의 고정 비밀입니다. 재시작·다중 worker에서도 같은 값을
# 사용해야 하며 저장소에 커밋하지 않습니다. 비어 있으면 프로세스 임시 키를 써서 기존 캐시를
# 재시작 뒤 신뢰하지 않고 GATE_STOPPED로 닫습니다.
PROVENANCE_SEAL_SECRET=

# [선택·로컬 전용] 로컬 HTTP 로그인에서만 1. Render 등 HTTPS 배포에서는 비워 둡니다.
AUTH_COOKIE_INSECURE=

# [선택·로컬 데모 전용] OAuth 없는 임시 관리자 입구입니다. 배포에서는 비워 둡니다.
# 직접 설정하지 말고 `로컬데모켜기.ps1`을 사용하세요. 실행기가 매번 만드는 32바이트
# capability와 데모·공개 모드·HTTP loopback 조건이 모두 맞아야만 전용 입구가 열립니다.
LOCAL_DEMO_AUTH=
# [로컬 실행기 전용·비밀] 실행기가 자식 프로세스에만 넣습니다. 수동 저장·배포 금지.
LOCAL_DEMO_AUTH_TOKEN=

# ── 영속 저장소 ───────────────────────────────────────────
# [선택] 데이터 루트. 로컬은 비워 두고, Render는 /var/data를 사용합니다.
APP_DATA_ROOT=

# [선택] SQLite 파일 경로. 비우면 앱의 로컬 기본 경로를 사용합니다.
STORAGE_DB_PATH=

# [선택] 비식별 실행 이력 파일 경로. 비우면 앱의 로컬 기본 경로를 사용합니다.
OBSERVABILITY_RECORDS_PATH=

# [선택] tldextract 캐시 경로. Render 설정은 영속 디스크 아래를 사용합니다.
TLDEXTRACT_CACHE=

# ── 실제 조사와 이미지 글자 추출 ─────────────────────────
# 아래 네 값은 PIPELINE=real 또는 AI 이미지 글자 추출을 사용할 때만 필요합니다.
# [실제 조사 필수·비밀] Anthropic API 키입니다.
ANTHROPIC_API_KEY=

# [실제 조사 필수·비밀] 금융감독원 DART API 키입니다.
DART_API_KEY=

# [실제 조사 필수] 네이버 뉴스 검색 API 클라이언트 ID입니다.
NAVER_CLIENT_ID=

# [실제 조사 필수·비밀] 네이버 뉴스 검색 API 클라이언트 보안 비밀입니다.
NAVER_CLIENT_SECRET=

# ── Notion 전송 ───────────────────────────────────────────
# [선택·비밀] Notion 전송을 사용할 때 필요한 통합 토큰입니다.
NOTION_TOKEN=

# [선택] 보고서를 만들 부모 Notion 페이지 ID입니다. 토큰과 함께 설정합니다.
NOTION_PARENT_PAGE_ID=

# ── 이미지 업로드 제한 ────────────────────────────────────
# [선택] 비우면 코드의 안전 상한(1장 5MiB, 4장, 합계 12MiB)을 사용합니다.
POSTING_IMAGE_MAX_BYTES=
POSTING_IMAGE_MAX_COUNT=
POSTING_IMAGE_MAX_TOTAL_BYTES=

# Docker가 내부에서 관리하는 PYTHON*·PIP_*·HOME 값과 시험 도구의
# PYTEST_CURRENT_TEST는 사용자 설정이 아니므로 이 견본에서 바꾸지 않습니다.
