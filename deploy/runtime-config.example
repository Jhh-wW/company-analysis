# 이 파일에는 실제 값을 넣지 않는다. runtime-config로 복사한 뒤 로컬에서만 채운다.
PIPELINE=demo
BETA_ADMIN_ONLY=1
LOG_LEVEL=info
DEPLOYMENT_EXPOSURE=local
DEPLOYMENT_PLATFORM=local
FORWARDED_ALLOW_IPS=127.0.0.1

# 공개 배포 입력 예시다. Render Docker는 검증 가능한 ingress peer CIDR이 없어
# 어떤 값을 채워도 BLOCKED이며, Kubernetes 역시 signed canary verifier가 설치되기
# 전에는 BLOCKED다. 아래 SHA-256 문자열만으로는 운영 증명이 되지 않는다.
PUBLIC_ORIGIN=
HTTPS_ORIGIN_CSRF_CANARY_EVIDENCE_SHA256=
CLIENT_IP_CANARY_EVIDENCE_SHA256=
RENDER_DIRECT_ORIGIN_BLOCK_EVIDENCE_SHA256=
RENDER_EDGE_XFF_SANITIZE_EVIDENCE_SHA256=
K8S_INGRESS_PROXY_CIDRS=
K8S_NETWORK_POLICY_EVIDENCE_SHA256=

ADMIN_EMAILS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
SHARE_PUBLIC_BASE_URL=

PROVENANCE_SEAL_SECRET=
ANTHROPIC_API_KEY=
DART_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=

# 외부 백업을 활성화할 때만 채운다. 실제 값은 저장소에 기록하지 않는다.
# 현재 저장소에는 production-ready manifest appender가 없으므로
# BACKUP_S3_BUCKET을 설정하면 환경 검증이 의도적으로 배포를 차단한다.
BACKUP_TRIGGER_SECRET=
BACKUP_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BACKUP_DATA_BOUNDARY_ID=
BACKUP_DATA_AUTHORITY_ID=
BACKUP_MANIFEST_MIN_RETENTION_DAYS=
